# Copy to wifi.env (gitignored) and fill in. Read by build.rs at build time.
# To have the board make its own open network (CoreS3-DOOM, no password) instead, leave both
# values empty or do not create wifi.env at all.
# The values are compiled into the firmware image, so treat the .bin/.elf as sensitive.
# Only WPA2 (or WPA/WPA2 mixed) networks work; WPA3-only is not supported by esp-radio.
WIFI_SSID=your-network-name
WIFI_PASSWORD=your-password
